# ==========================================
# AI YOUTUBE SHORTS AUTOMATION PLATFORM
# Environment Configuration Template
# ==========================================

# Node & Server
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# PostgreSQL Database (Prisma)
# Local: postgresql://postgres:postgres@localhost:5432/yt_shorts_db?schema=public
# Render: Render Dashboard -> Postgres -> Internal Connection String
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/yt_shorts_db?schema=public

# Session Secret (Generate a strong random string)
SESSION_SECRET=change-this-to-a-very-long-random-string-in-production

# Default Admin Credentials (Used by seed script or first-time wizard)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Cron-job.org Secret (Used to authenticate POST /api/cron/generate-short-1 & generate-short-2)
# Header: Authorization: Bearer YOUR_CRON_SECRET
CRON_SECRET=replace-with-a-secret-random-token-here

# Timezone (Defaults to Asia/Kolkata)
TIMEZONE=Asia/Kolkata

# Daily Publishing Targets
DAILY_SHORT_COUNT=2
SHORT_1_TIME=10:00
SHORT_2_TIME=19:00

# AI / LLM Configuration
# Options: "gemini" or "openai"
LLM_PROVIDER=gemini
# For Gemini: Get free key from Google AI Studio: https://aistudio.google.com/
# For OpenAI: https://platform.openai.com/api-keys
LLM_API_KEY=your_gemini_or_openai_api_key_here
LLM_MODEL=gemini-1.5-flash

# Research Providers
# Options: "rss", "searchapi", or "multi"
RESEARCH_PROVIDER=rss
SEARCH_API_KEY=

# TTS (Voiceover) Configuration
# Options: "openai" or "elevenlabs"
TTS_PROVIDER=openai
TTS_API_KEY=your_openai_or_elevenlabs_api_key_here
# OpenAI Voices: alloy, echo, fable, onyx, nova, shimmer
TTS_VOICE=alloy

# Object Storage Configuration (Cloudflare R2, AWS S3, Backblaze B2, or "local")
STORAGE_PROVIDER=local
STORAGE_BUCKET=yt-shorts-bucket
STORAGE_REGION=auto
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Google Cloud Console & YouTube OAuth 2.0
# 1. Go to console.cloud.google.com
# 2. Enable "YouTube Data API v3"
# 3. Create OAuth 2.0 Web Client credentials
# 4. Add Authorized Redirect URI: http://localhost:3000/admin/youtube/callback
#    (or https://YOUR-APP.onrender.com/admin/youtube/callback on Render)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/admin/youtube/callback

# YouTube Upload Settings
# Options: "public", "unlisted", "private"
YOUTUBE_PRIVACY_STATUS=public

# Branding & Customization
CHANNEL_NAME=AI Daily Radar
WATERMARK_TEXT=@AIDailyRadar
DEFAULT_CTA=Follow for daily breakthrough AI tools 🚀
ENABLE_BACKGROUND_MUSIC=false

# System FFmpeg / FFprobe Paths (Leave empty to use automatic installer binaries)
FFMPEG_PATH=
FFPROBE_PATH=
