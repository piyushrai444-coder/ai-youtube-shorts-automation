<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-950 text-slate-100">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | AI YouTube Shorts</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-full flex items-center justify-center p-4 font-sans antialiased">
  <div class="w-full max-w-lg bg-slate-900 border border-slate-800 rounded-3xl p-8 shadow-2xl text-center">
    <div class="w-14 h-14 rounded-2xl bg-rose-500/10 text-rose-500 flex items-center justify-center mx-auto text-2xl font-bold mb-4">
      ✕
    </div>
    <h1 class="text-xl font-extrabold text-white mb-2"><%= title %></h1>
    <p class="text-xs text-rose-400 font-mono mb-6 bg-rose-950/40 border border-rose-900/40 p-4 rounded-xl text-left overflow-x-auto">
      <%= message %>
    </p>

    <% if (typeof stack !== 'undefined' && stack) { %>
      <pre class="text-[10px] text-slate-500 font-mono text-left bg-slate-950 p-4 rounded-xl overflow-x-auto mb-6 max-h-48 border border-slate-800">
        <%= stack %>
      </pre>
    <% } %>

    <div class="flex justify-center gap-3">
      <a href="/admin" class="px-5 py-2.5 rounded-xl font-semibold text-xs bg-indigo-600 hover:bg-indigo-500 text-white transition">
        Return to Dashboard
      </a>
    </div>
  </div>
</body>
</html>
