<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-950 text-slate-100">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | AI YouTube Shorts</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-full flex items-center justify-center p-4 font-sans antialiased">
  <div class="w-full max-w-lg bg-slate-900/90 border border-slate-800 rounded-3xl p-8 shadow-2xl backdrop-blur-xl">
    <div class="text-center mb-6">
      <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-indigo-500 to-rose-500 flex items-center justify-center font-bold text-white shadow-lg shadow-indigo-500/30 mx-auto text-xl mb-3">
        🚀
      </div>
      <h1 class="text-2xl font-extrabold text-white">First-Time Setup Wizard</h1>
      <p class="text-xs text-slate-400 mt-1">Initialize your admin credentials and automation settings.</p>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="mb-6 rounded-xl bg-rose-500/10 border border-rose-500/20 p-3 text-xs text-rose-400 text-center font-medium">
        <%= error %>
      </div>
    <% } %>

    <form action="/admin/setup" method="POST" class="space-y-4">
      <div class="border-b border-slate-800 pb-4">
        <h2 class="text-xs font-bold uppercase tracking-wider text-indigo-400 mb-3">1. Admin Account</h2>
        <div class="space-y-3">
          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-1">Admin Username</label>
            <input type="text" name="username" value="admin" required
              class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-white text-sm focus:outline-none focus:border-indigo-500">
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-1">Admin Password (min. 8 characters)</label>
            <input type="password" name="password" required minlength="8"
              class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-white text-sm focus:outline-none focus:border-indigo-500">
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-1">Confirm Password</label>
            <input type="password" name="confirmPassword" required minlength="8"
              class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-white text-sm focus:outline-none focus:border-indigo-500">
          </div>
        </div>
      </div>

      <div class="border-b border-slate-800 pb-4">
        <h2 class="text-xs font-bold uppercase tracking-wider text-indigo-400 mb-3">2. Initial Configuration (Optional)</h2>
        <div class="space-y-3">
          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-1">LLM AI Provider</label>
            <select name="llmProvider" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-white text-sm focus:outline-none focus:border-indigo-500">
              <option value="gemini">Google Gemini (Recommended)</option>
              <option value="openai">OpenAI (GPT-4o-mini)</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-1">LLM API Key</label>
            <input type="password" name="llmApiKey" placeholder="AIza... or sk-..."
              class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-white text-sm focus:outline-none focus:border-indigo-500 font-mono">
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-1">Channel Display Name</label>
            <input type="text" name="channelName" value="AI Daily Radar"
              class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-white text-sm focus:outline-none focus:border-indigo-500">
          </div>
        </div>
      </div>

      <button type="submit" class="w-full py-3.5 rounded-xl font-bold text-sm bg-gradient-to-r from-indigo-500 to-indigo-600 hover:from-indigo-600 hover:to-indigo-700 text-white shadow-xl shadow-indigo-500/25 transition active:scale-95">
        Complete Setup & Enter Dashboard →
      </button>
    </form>
  </div>
</body>
</html>
