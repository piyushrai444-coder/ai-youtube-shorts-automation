<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - AI Shorts Growth Agent</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col font-sans antialiased">
  <%- include('../partials/navbar') %>

  <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
    <%- include('../partials/flash') %>

    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 border-b border-slate-800 pb-6">
      <div>
        <div class="flex items-center gap-3">
          <h1 class="text-2xl sm:text-3xl font-black text-white tracking-tight">Topic Intelligence & Scoring</h1>
          <span class="px-2.5 py-0.5 text-xs font-semibold rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
            Multi-Factor Engine
          </span>
        </div>
        <p class="text-sm text-slate-400 mt-1">
          Formula: (Freshness×15%) + (Utility×20%) + (Curiosity×15%) + (Visual×15%) + (Trend×10%) + (Demo×15%) - Penalty
        </p>
      </div>

      <div>
        <form action="/admin/shorts/generate" method="POST">
          <button type="submit" class="px-4 py-2 bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white text-sm font-semibold rounded-xl transition shadow-lg shadow-emerald-500/20">
            Generate Short from Top Topic
          </button>
        </form>
      </div>
    </div>

    <!-- Topics Table -->
    <div class="bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden shadow-lg">
      <div class="px-6 py-4 border-b border-slate-800 flex items-center justify-between">
        <h2 class="text-base font-semibold text-white">Discovered AI Topics (<%= topics.length %>)</h2>
        <span class="text-xs text-slate-400">Ranked by Final Viral Score</span>
      </div>

      <% if (topics.length === 0) { %>
        <div class="p-8 text-center text-slate-400">
          <p>No topics discovered yet. Trigger research or generate a short to populate candidates.</p>
        </div>
      <% } else { %>
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="border-b border-slate-800 text-xs font-semibold uppercase tracking-wider text-slate-400 bg-slate-950/50">
                <th class="px-6 py-3.5">Topic & Source</th>
                <th class="px-3 py-3.5 text-center">Final Score</th>
                <th class="px-3 py-3.5 text-center">Freshness</th>
                <th class="px-3 py-3.5 text-center">Utility</th>
                <th class="px-3 py-3.5 text-center">Curiosity</th>
                <th class="px-3 py-3.5 text-center">Visual/Demo</th>
                <th class="px-3 py-3.5 text-center">Status</th>
                <th class="px-4 py-3.5">Discovered</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-800/60 text-sm">
              <% topics.forEach(t => { %>
                <tr class="hover:bg-slate-800/40 transition">
                  <td class="px-6 py-4 max-w-sm">
                    <div class="font-medium text-white truncate" title="<%= t.title %>">
                      <a href="<%= t.sourceUrl %>" target="_blank" class="hover:text-indigo-400 transition underline-offset-2">
                        <%= t.title %>
                      </a>
                    </div>
                    <div class="text-xs text-slate-400 mt-1 line-clamp-1"><%= t.summary %></div>
                    <div class="flex items-center gap-2 mt-1">
                      <span class="text-xs font-mono text-slate-500"><%= t.source %></span>
                      <% if (t.sourceCount > 1) { %>
                        <span class="px-1.5 py-0.2 text-[10px] font-bold rounded bg-indigo-500/10 text-indigo-400 border border-indigo-500/20">
                          <%= t.sourceCount %> sources
                        </span>
                      <% } %>
                    </div>
                  </td>

                  <td class="px-3 py-4 text-center">
                    <span class="px-2.5 py-1 text-xs font-black rounded-lg <%= (t.finalScore || t.score) >= 75 ? 'bg-emerald-500/20 text-emerald-400 border border-emerald-500/30' : 'bg-slate-800 text-slate-300' %>">
                      <%= Math.round(t.finalScore || t.score) %>
                    </span>
                  </td>

                  <td class="px-3 py-4 text-center font-mono text-xs text-slate-300">
                    <%= Math.round(t.freshnessScore || 0) %>
                  </td>

                  <td class="px-3 py-4 text-center font-mono text-xs text-emerald-400">
                    <%= Math.round(t.usefulnessScore || 0) %>
                  </td>

                  <td class="px-3 py-4 text-center font-mono text-xs text-purple-400">
                    <%= Math.round(t.curiosityScore || 0) %>
                  </td>

                  <td class="px-3 py-4 text-center font-mono text-xs text-cyan-400">
                    <%= Math.round(t.visualScore || 0) %>
                  </td>

                  <td class="px-3 py-4 text-center">
                    <% if (t.used) { %>
                      <span class="px-2 py-0.5 text-[11px] font-semibold rounded bg-slate-800 text-slate-500">
                        Used
                      </span>
                    <% } else { %>
                      <span class="px-2 py-0.5 text-[11px] font-semibold rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                        Fresh
                      </span>
                    <% } %>
                  </td>

                  <td class="px-4 py-4 text-xs text-slate-400">
                    <%= new Date(t.discoveredAt).toLocaleDateString() %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </main>
</body>
</html>
