<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-950 text-slate-100">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | AI YouTube Shorts</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-full flex flex-col font-sans antialiased selection:bg-indigo-500 selection:text-white">
  <%- include('../partials/navbar') %>

  <main class="flex-1 max-w-4xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <%- include('../partials/flash') %>

    <div class="pb-6 border-b border-slate-800">
      <h1 class="text-2xl font-bold tracking-tight text-white">YouTube OAuth Connection</h1>
      <p class="text-sm text-slate-400 mt-1">Connect your verified YouTube channel via Google OAuth 2.0 to automate Shorts publishing.</p>
    </div>

    <!-- Status Card -->
    <div class="mt-8 bg-slate-900/60 border border-slate-800 rounded-3xl p-8 shadow-xl">
      <% if (isConnected && channelInfo) { %>
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-6">
          <div class="flex items-center gap-4">
            <% if (channelInfo.thumbnail) { %>
              <img src="<%= channelInfo.thumbnail %>" alt="Channel" class="w-16 h-16 rounded-full border-2 border-emerald-500/40 shadow-lg shadow-emerald-950">
            <% } else { %>
              <div class="w-16 h-16 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center font-bold text-xl border-2 border-emerald-500/40">
                YT
              </div>
            <% } %>
            <div>
              <div class="flex items-center gap-2">
                <h2 class="text-lg font-extrabold text-white"><%= channelInfo.title %></h2>
                <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/30">
                  <svg class="w-3.5 h-3.5 text-emerald-400" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                  </svg>
                  Connected ✓
                </span>
              </div>
              <div class="text-xs text-slate-400 font-mono mt-1">Channel ID: <%= channelInfo.id %></div>
              <% if (channelInfo.customUrl) { %>
                <div class="text-xs text-indigo-400 mt-0.5"><%= channelInfo.customUrl %></div>
              <% } %>
            </div>
          </div>

          <form action="/admin/youtube/disconnect" method="POST" onsubmit="return confirm('Disconnect this YouTube channel?');">
            <button type="submit" class="px-4 py-2.5 rounded-xl text-xs font-semibold bg-rose-950/60 hover:bg-rose-900/60 text-rose-300 border border-rose-800/40 transition">
              Disconnect Channel
            </button>
          </form>
        </div>
      <% } else { %>
        <div class="text-center py-6">
          <div class="w-16 h-16 rounded-2xl bg-rose-500/10 text-rose-500 flex items-center justify-center mx-auto text-2xl font-bold mb-4">
            ▶
          </div>
          <h2 class="text-lg font-bold text-white">No YouTube Channel Connected</h2>
          <p class="text-xs text-slate-400 max-w-md mx-auto mt-1 mb-6">
            Authorize your YouTube channel to enable automatic daily uploads with custom titles, descriptions, and hashtags.
          </p>

          <% if (hasCredentials) { %>
            <a href="/admin/youtube/connect" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl font-bold text-sm bg-gradient-to-r from-rose-600 to-rose-700 hover:from-rose-500 hover:to-rose-600 text-white shadow-xl shadow-rose-950 transition active:scale-95">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
              </svg>
              Connect YouTube Channel
            </a>
          <% } else { %>
            <div class="inline-block p-4 rounded-xl bg-amber-500/10 border border-amber-500/30 text-amber-300 text-xs text-left max-w-lg mb-6">
              ⚠️ Google OAuth Client ID and Secret are required before connecting. Please enter them below or configure them in your Render environment variables.
            </div>
          <% } %>
        </div>
      <% } %>
    </div>

    <!-- Google OAuth Credentials Form -->
    <div class="mt-8 bg-slate-900/60 border border-slate-800 rounded-2xl p-6">
      <h3 class="text-sm font-bold text-white mb-2 flex items-center gap-2">
        <svg class="w-4 h-4 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
        </svg>
        Google OAuth 2.0 Client Credentials
      </h3>
      <p class="text-xs text-slate-400 mb-4">
        Enter the OAuth client ID & secret created in Google Cloud Console.
      </p>

      <form action="/admin/settings/youtube/credentials" method="POST" class="space-y-4">
        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1">Google Client ID</label>
          <input type="text" name="googleClientId" value="<%= clientId %>" placeholder="xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com" required
            class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-white text-xs font-mono focus:outline-none focus:border-indigo-500">
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1">Google Client Secret</label>
          <input type="password" name="googleClientSecret" placeholder="<%= hasCredentials ? '•••••••••••••••• (Leave blank to keep existing)' : 'GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx' %>" <%= hasCredentials ? '' : 'required' %>
            class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-white text-xs font-mono focus:outline-none focus:border-indigo-500">
        </div>
        <div class="flex justify-end pt-2">
          <button type="submit" class="px-5 py-2 rounded-xl text-xs font-semibold bg-indigo-600 hover:bg-indigo-500 text-white shadow transition">
            Save Google Credentials
          </button>
        </div>
      </form>
    </div>

    <!-- Google Cloud Console Setup Guide -->
    <div class="mt-8 bg-slate-900/40 border border-slate-800/80 rounded-2xl p-6">
      <h3 class="text-sm font-bold text-white mb-2 flex items-center gap-2">
        <svg class="w-4 h-4 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        Google Cloud Setup Instructions
      </h3>

      <div class="text-xs text-slate-400 space-y-2 mt-3">
        <div>1. Go to <a href="https://console.cloud.google.com/apis/library/youtube.googleapis.com" target="_blank" class="text-indigo-400 underline">Google Cloud Console → YouTube Data API v3</a> and click <strong>Enable</strong>.</div>
        <div>2. Go to <strong>OAuth consent screen</strong>: Set user type to <strong>External</strong>, and add your email under Test Users.</div>
        <div>3. Add Scope: <code class="text-indigo-300 font-mono">https://www.googleapis.com/auth/youtube.upload</code></div>
        <div>4. Go to <strong>Credentials</strong> → <strong>Create Credentials</strong> → <strong>OAuth client ID</strong> (Application type: <em>Web application</em>).</div>
        <div>5. Under <strong>Authorized redirect URIs</strong>, add:</div>
        <div class="bg-slate-950 rounded-xl p-3 font-mono text-xs text-indigo-300 border border-slate-800 select-all">
          <%= redirectUri %>
        </div>
        <div>6. Copy the generated <strong>Client ID</strong> and <strong>Client Secret</strong> into the form above.</div>
      </div>
    </div>
  </main>
</body>
</html>
