datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ShortStatus {
  RESEARCHING
  TOPIC_SELECTED
  SCRIPT_GENERATED
  VOICE_GENERATED
  VIDEO_GENERATING
  VIDEO_READY
  UPLOAD_PENDING
  UPLOADING
  UPLOADED
  FAILED
  RETRY_PENDING
  CANCELLED
  VALIDATION_FAILED
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

model Topic {
  id              String         @id @default(uuid())
  title           String
  sourceUrl       String
  source          String
  summary         String
  category        String         @default("AI Tools")
  publishedAt     DateTime?
  contentHash     String         @unique
  score           Float          @default(0.0)
  freshnessScore  Float          @default(0.0)
  trendScore      Float          @default(0.0)
  usefulnessScore Float          @default(0.0)
  visualScore     Float          @default(0.0)
  finalScore      Float          @default(0.0)
  sourceCount     Int            @default(1)
  company         String?
  used            Boolean        @default(false)
  discoveredAt    DateTime       @default(now())
  createdAt       DateTime       @default(now())
  shorts          Short[]
  hookVariants    HookVariant[]

  @@index([used])
  @@index([discoveredAt])
  @@index([category])
  @@map("topics")
}

model Short {
  id                   String                @id @default(uuid())
  slotKey              String?               @unique // e.g. "2026-10-02-short-1"
  topicId              String?
  topic                Topic?                @relation(fields: [topicId], references: [id], onDelete: SetNull)
  title                String
  script               String
  description          String
  tags                 String                @default("AI,Artificial Intelligence,AITools,Tech,Shorts")
  category             String                @default("AI Tools")
  contentMode          String                @default("AI_TOOLS") // AI_TOOLS, CARTOON
  format               String                @default("TOOL_DISCOVERY") // TOOL_DISCOVERY, DEMONSTRATION, PROBLEM_SOLUTION, etc. OR FUNNY, CUTE_ANIMAL, UNEXPECTED_ENDING, etc.
  hookStyle            String?               // CURIOSITY_GAP, CONTRARIAN, RESULT_FIRST, etc.
  selectedHook         String?
  storyIdeaId          String?
  storyIdea            StoryIdea?            @relation(fields: [storyIdeaId], references: [id], onDelete: SetNull)
  characterIds         String[]              @default([])
  experimentId         String?
  experiment           ContentExperiment?    @relation(fields: [experimentId], references: [id], onDelete: SetNull)
  contentQualityScore  Float?
  viralityScore        Float?
  performanceClass     String?               // TOP_PERFORMER, ABOVE_AVERAGE, AVERAGE, BELOW_AVERAGE, POOR
  status               ShortStatus           @default(RESEARCHING)
  videoUrl             String?
  audioUrl             String?
  captionsUrl          String?
  thumbnailUrl         String?
  durationSeconds      Float?
  youtubeVideoId       String?
  youtubeUrl           String?
  errorMessage         String?
  retryCount           Int                   @default(0)
  scheduledAt          DateTime?
  uploadedAt           DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  hookVariants         HookVariant[]
  performanceSnapshots PerformanceSnapshot[]

  @@index([status])
  @@index([slotKey])
  @@index([createdAt])
  @@index([format])
  @@index([contentMode])
  @@index([performanceClass])
  @@map("shorts")
}

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@index([key])
  @@map("settings")
}

model JobRun {
  id           String    @id @default(uuid())
  slotKey      String?   // Idempotency key e.g. "2026-10-02-short-1"
  jobType      String    // "DAILY_SHORT_1", "DAILY_SHORT_2", "MANUAL", "RETRY"
  status       JobStatus @default(PENDING)
  shortId      String?
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  errorMessage String?
  metadata     String?   // JSON payload with logs and step details
  retryCount   Int       @default(0)
  nextRetryAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([slotKey])
  @@index([status])
  @@index([startedAt])
  @@map("job_runs")
}

// Session table for connect-pg-simple
model Session {
  sid    String   @id
  sess   Json
  expire DateTime

  @@index([expire])
  @@map("session")
}

model HookVariant {
  id               String   @id @default(uuid())
  shortId          String?
  short            Short?   @relation(fields: [shortId], references: [id], onDelete: Cascade)
  topicId          String?
  topic            Topic?   @relation(fields: [topicId], references: [id], onDelete: SetNull)
  hookText         String
  patternType      String   // CURIOSITY_GAP, CONTRARIAN, RESULT_FIRST, PROBLEM_AGITATION, RELATABLE_FRUSTRATION
  clarityScore     Float    @default(0.0)
  curiosityScore   Float    @default(0.0)
  specificityScore Float    @default(0.0)
  valueScore       Float    @default(0.0)
  totalScore       Float    @default(0.0)
  selected         Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@index([shortId])
  @@index([topicId])
  @@index([patternType])
  @@map("hook_variants")
}

model ContentExperiment {
  id           String   @id @default(uuid())
  name         String
  format       String   // TOOL_DISCOVERY, DEMONSTRATION, PROBLEM_SOLUTION, etc.
  hookStyle    String?
  hypothesis   String?
  targetMetric String   @default("avgPercentageViewed")
  status       String   @default("ACTIVE") // ACTIVE, COMPLETED, PAUSED
  sampleCount  Int      @default(0)
  winCount     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  shorts       Short[]

  @@index([status])
  @@index([format])
  @@map("content_experiments")
}

model PerformanceSnapshot {
  id                     String   @id @default(uuid())
  shortId                String
  short                  Short    @relation(fields: [shortId], references: [id], onDelete: Cascade)
  youtubeVideoId         String
  snapshotPeriod         String   // "1h", "6h", "24h", "48h", "7d"
  views                  Int      @default(0)
  likes                  Int      @default(0)
  comments               Int      @default(0)
  shares                 Int      @default(0)
  subscribersGained      Int      @default(0)
  viewedVsSwiped         Float?   // % who chose to view
  avgViewDuration        Float?   // in seconds
  avgPercentageViewed    Float?   // percentage e.g. 85.5%
  estimatedRetentionRate Float?
  rawAnalytics           Json?
  fetchedAt              DateTime @default(now())

  @@index([shortId])
  @@index([youtubeVideoId])
  @@index([snapshotPeriod])
  @@index([fetchedAt])
  @@map("performance_snapshots")
}

model LearningInsight {
  id             String   @id @default(uuid())
  category       String   // "FORMAT", "HOOK", "TOPIC_CATEGORY", "PACING", "RETENTION"
  title          String
  description    String
  metric         String   // "avgPercentageViewed", "viewedVsSwiped", "views"
  impactScore    Float    @default(0.0) // Relative lift or score
  sampleSize     Int      @default(0)
  confidence     String   @default("OBSERVATION") // "OBSERVATION", "HYPOTHESIS", "STRONG_PATTERN"
  actionableRule String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([category])
  @@index([confidence])
  @@index([active])
  @@map("learning_insights")
}

model StrategyRun {
  id                  String   @id @default(uuid())
  slotKey             String?
  chosenFormat        String
  chosenTopicCategory String
  rationale           String
  appliedInsights     Json?
  createdAt           DateTime @default(now())

  @@index([slotKey])
  @@index([createdAt])
  @@map("strategy_runs")
}

model Character {
  id               String   @id @default(uuid())
  name             String   @unique
  species          String
  ageGroup         String   @default("young") // young, adult, elder
  personality      String[]
  appearance       Json     // { fur, eyes, ears, build, distinctTraits }
  clothing         Json     // { outfit, accessories, colors }
  voiceProfile     Json     // { voiceName, voiceType, pitch, speed, emotion }
  referenceImage   String?  // Reference asset URL
  bible            String   // Persistent character bible (locked traits)
  appearanceCount  Int      @default(0)
  avgRetention     Float    @default(0.0)
  avgViews         Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  scenes           Scene[]

  @@index([species])
  @@map("characters")
}

model StoryIdea {
  id              String      @id @default(uuid())
  title           String
  premise         String
  format          String      // FUNNY, CUTE_ANIMAL, UNEXPECTED_ENDING, EMOTIONAL, WHOLESOME, ADVENTURE, PROBLEM_SOLUTION, etc.
  hookPattern     String
  emotionalArc    String
  characters      String[]
  storyScore      Float       @default(0.0)
  scoreBreakdown  Json?
  status          String      @default("APPROVED") // DRAFT, APPROVED, REJECTED, PRODUCED
  createdAt       DateTime    @default(now())
  storyboard      Storyboard?
  shorts          Short[]

  @@index([format])
  @@index([status])
  @@index([storyScore])
  @@map("story_ideas")
}

model Storyboard {
  id             String    @id @default(uuid())
  storyIdeaId    String    @unique
  storyIdea      StoryIdea @relation(fields: [storyIdeaId], references: [id], onDelete: Cascade)
  targetDuration Float     @default(38.0)
  totalScenes    Int       @default(6)
  createdAt      DateTime  @default(now())
  scenes         Scene[]

  @@map("storyboards")
}

model Scene {
  id              String     @id @default(uuid())
  storyboardId    String
  storyboard      Storyboard @relation(fields: [storyboardId], references: [id], onDelete: Cascade)
  sceneIndex      Int
  durationSeconds Float
  location        String
  characterAction String
  dialogue        String?
  speakerName     String?
  characterId     String?
  character       Character? @relation(fields: [characterId], references: [id], onDelete: SetNull)
  emotion         String     @default("neutral")
  voiceDirection  Json?      // { speed, pitch, emotion, pauseMs }
  sfxCue          String?    // e.g. "footsteps", "school bell", "whoosh", "pop", "gasp"
  cameraAngle     String     @default("medium") // close-up, medium, wide, low-angle
  visualPrompt    String
  imagePath       String?
  videoPath       String?
  createdAt       DateTime   @default(now())

  @@index([storyboardId])
  @@index([sceneIndex])
  @@map("scenes")
}


